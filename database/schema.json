{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HindiKavitaDocument",
  "description": "Firestore document schema for a Hindi Poem (Kavita)",
  "type": "object",
  "required": [
    "title",
    "poet_name",
    "category",
    "body",
    "is_published",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique Firestore Document ID"
    },
    "title": {
      "type": "string",
      "description": "Poem title in Devanagari script (e.g., रश्मिरथी, मधुशाला)"
    },
    "title_search": {
      "type": "string",
      "description": "Normalized Romanized / Hinglish + Devanagari search tokens"
    },
    "poet_name": {
      "type": "string",
      "description": "Name of the poet (e.g., हरिवंश राय बच्चन, रामधारी सिंह 'दिनकर')"
    },
    "category": {
      "type": "string",
      "enum": [
        "वीर रस",
        "प्रेम",
        "भक्ति",
        "प्रकृति",
        "जीवन और दर्शन",
        "हास्य / व्यंग्य"
      ],
      "description": "Kavita category"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Search and thematic tags"
    },
    "body": {
      "type": "string",
      "description": "Full Devanagari poem text with preserved newline breaks and stanzas"
    },
    "stanza_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of stanzas (छंद)"
    },
    "estimated_reading_minutes": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated reading duration in minutes"
    },
    "is_published": {
      "type": "boolean",
      "description": "Whether the poem is published and visible on the mobile app"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured on the app home carousel"
    },
    "views_count": {
      "type": "integer",
      "default": 0
    },
    "likes_count": {
      "type": "integer",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

