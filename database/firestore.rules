rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /poems/{poemId} {
      // Readers can only view published poems; authenticated users/admins can see drafts as well
      allow read: if resource.data.is_published == true || request.auth != null;

      // Only authenticated admins can write (create, update, delete)
      allow create, update, delete: if request.auth != null;
    }
  }
}

